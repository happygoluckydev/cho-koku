# Anthropic API（Claudeとの対話・ブラッシュアップに使用）
ANTHROPIC_API_KEY=

# Supabase（アイデアの記録先。サーバー側のAPIルートからのみ使用する）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# /api/chat を保護する簡易トークン。クライアントとサーバーで同じ値を共有する
# NOTE: 認証は Cloudflare Access に委ねることが決定済み（docs/review-2026-09-03.md 指摘4）。
#       Access 導入後にこの変数と関連コードは削除する。
APP_API_TOKEN=
